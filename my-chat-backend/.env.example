PORT=3001
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/chatApp
TEST_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/chatAppTest
SECRET=replace-with-a-long-random-string
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
# Set to 1 only behind one trusted reverse proxy, such as your hosting proxy.
TRUST_PROXY=0
# Optional Google OAuth web client. Keep the client secret on the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
